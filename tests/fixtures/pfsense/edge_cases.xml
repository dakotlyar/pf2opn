<?xml version="1.0"?>
<pfsense>
	<version>24.0</version>
	<system>
		<hostname>edgebox</hostname>
		<domain>example.test</domain>
	</system>
	<interfaces>
		<wan>
			<if>em0</if>
			<descr>WAN</descr>
			<enable></enable>
			<ipaddr>dhcp</ipaddr>
		</wan>
		<lan>
			<if>em1</if>
			<descr>LAN</descr>
			<enable></enable>
			<ipaddr>192.168.1.1</ipaddr>
			<subnet>24</subnet>
		</lan>
	</interfaces>
	<snmpd>
		<syslocation>rack 1</syslocation>
		<syscontact>dave@example.test</syscontact>
		<rocommunity>syntheticcommunity</rocommunity>
	</snmpd>
	<ipsec>
		<mobilekey>
			<refid>m1</refid>
			<ident>mobile.example.test</ident>
			<psk>syntheticpsk</psk>
		</mobilekey>
		<client>
			<user>roadwarrior</user>
			<ident>roadwarrior.example.test</ident>
		</client>
	</ipsec>
	<dyndnses>
		<dyndns>
			<enable></enable>
			<service>cloudflare</service>
			<host>dynamic</host>
			<domainname>edge.example.test</domainname>
			<username>user@example.test</username>
			<password>syntheticpassword</password>
			<interface>wan</interface>
		</dyndns>
	</dyndnses>
	<ovpnserver>
		<step1>true</step1>
		<step2>true</step2>
		<step3>true</step3>
		<step4>true</step4>
		<step5>true</step5>
	</ovpnserver>
	<cron>
		<item>
			<minute>0</minute>
			<hour>3</hour>
			<mday>*</mday>
			<month>*</month>
			<wday>*</wday>
			<who>root</who>
			<command>/usr/local/bin/my-script.sh --daily</command>
		</item>
	</cron>
</pfsense>
