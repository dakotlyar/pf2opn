<?xml version="1.0"?>
<pfsense>
	<version>24.0</version>
	<system>
		<hostname>dhcpbox</hostname>
		<domain>example.test</domain>
	</system>
	<interfaces>
		<wan>
			<if>em0</if>
			<descr>WAN</descr>
			<enable></enable>
			<ipaddr>dhcp</ipaddr>
		</wan>
		<lan>
			<if>em1</if>
			<descr>LAN</descr>
			<enable></enable>
			<ipaddr>192.168.1.1</ipaddr>
			<subnet>24</subnet>
		</lan>
		<opt1>
			<if>em2</if>
			<descr>OPT1 lab</descr>
			<enable></enable>
			<ipaddr>10.0.10.1</ipaddr>
			<subnet>24</subnet>
		</opt1>
	</interfaces>
	<dhcpd>
		<lan>
			<enable></enable>
			<range>
				<from>192.168.1.100</from>
				<to>192.168.1.199</to>
			</range>
			<gateway>192.168.1.1</gateway>
			<dnsserver>192.168.1.1</dnsserver>
			<dnsserver>9.9.9.9</dnsserver>
			<domain>lan.example.test</domain>
			<domainsearchlist>lan.example.test;example.test</domainsearchlist>
			<ntpserver>192.168.1.1</ntpserver>
			<defaultleasetime>7200</defaultleasetime>
			<maxleasetime>86400</maxleasetime>
			<staticmap>
				<mac>AA:BB:CC:DD:EE:01</mac>
				<ipaddr></ipaddr>
				<hostname>noip</hostname>
			</staticmap>
			<staticmap>
				<mac>8C:CE:4E:4B:9E:52</mac>
				<ipaddr>192.168.1.11</ipaddr>
				<hostname>host_underscore</hostname>
			</staticmap>
			<staticmap>
				<mac>8c:ce:4e:4b:9e:53</mac>
				<ipaddr>192.168.1.12</ipaddr>
				<hostname>perhost</hostname>
				<dnsserver>1.1.1.1</dnsserver>
				<gateway>192.168.1.1</gateway>
				<domain>perhost.example.test</domain>
			</staticmap>
		</lan>
		<opt1>
			<enable></enable>
			<range>
				<from>10.0.10.100</from>
				<to>10.0.10.150</to>
			</range>
			<pool>
				<range>
					<from>10.0.10.200</from>
					<to>10.0.10.220</to>
				</range>
			</pool>
			<denyunknown></denyunknown>
			<filename>pxelinux.0</filename>
			<tftp>10.0.10.5</tftp>
			<nextserver>10.0.10.5</nextserver>
			<failover_peerip>10.0.99.2</failover_peerip>
			<staticmap>
				<mac>aa:bb:cc:dd:ee:99</mac>
				<ipaddr>10.0.10.77</ipaddr>
				<hostname>labhost</hostname>
				<descr>lab host</descr>
			</staticmap>
		</opt1>
	</dhcpd>
</pfsense>
