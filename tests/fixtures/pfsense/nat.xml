<?xml version="1.0"?>
<pfsense>
	<version>24.0</version>
	<system>
		<hostname>natbox</hostname>
		<domain>example.test</domain>
	</system>
	<interfaces>
		<wan>
			<if>em0</if>
			<descr>WAN</descr>
			<enable></enable>
			<ipaddr>dhcp</ipaddr>
		</wan>
		<lan>
			<if>em1</if>
			<descr>LAN</descr>
			<enable></enable>
			<ipaddr>192.168.1.1</ipaddr>
			<subnet>24</subnet>
		</lan>
		<opt1>
			<if>em2</if>
			<descr>OPT1</descr>
			<enable></enable>
			<ipaddr>10.0.10.1</ipaddr>
			<subnet>24</subnet>
		</opt1>
		<opt7>
			<if>em3</if>
			<descr>OPT7</descr>
			<enable></enable>
			<ipaddr>10.0.7.1</ipaddr>
			<subnet>24</subnet>
		</opt7>
	</interfaces>
	<aliases>
		<alias>
			<name>WEBSERVER</name>
			<type>host</type>
			<address>192.168.1.50</address>
			<descr>web server</descr>
		</alias>
	</aliases>
	<filter>
		<rule>
			<type>pass</type>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<destination>
				<any></any>
				<port>8443</port>
			</destination>
			<associated-rule-id>nat_60000000000000.00000001</associated-rule-id>
			<tracker>2000</tracker>
			<descr>web forward auto rule</descr>
		</rule>
	</filter>
	<nat>
		<rule>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<source>
				<any></any>
			</source>
			<destination>
				<network>wanip</network>
				<port>8443</port>
			</destination>
			<target>192.168.1.50</target>
			<local-port>443</local-port>
			<descr>web forward</descr>
			<associated-rule-id>nat_60000000000000.00000001</associated-rule-id>
		</rule>
		<rule>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<source>
				<any></any>
			</source>
			<destination>
				<network>lanip</network>
				<port>8080</port>
			</destination>
			<target>WEBSERVER</target>
			<local-port>80</local-port>
			<descr>alias forward</descr>
		</rule>
		<rule>
			<interface>wan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>udp</protocol>
			<source>
				<any></any>
			</source>
			<destination>
				<network>wanip</network>
				<port>5353</port>
			</destination>
			<target>192.168.1.60</target>
			<local-port>53</local-port>
			<natreflection>enable</natreflection>
			<descr>reflection forward</descr>
		</rule>
		<outbound>
			<mode>hybrid</mode>
			<rule>
				<interface>wan</interface>
				<ipprotocol>inet</ipprotocol>
				<source>
					<network>lan</network>
				</source>
				<destination>
					<any></any>
				</destination>
				<target>wanip</target>
				<descr>wan interface address</descr>
			</rule>
			<rule>
				<interface>wan</interface>
				<ipprotocol>inet</ipprotocol>
				<source>
					<network>lan</network>
				</source>
				<destination>
					<any></any>
				</destination>
				<target>opt7ip</target>
				<descr>opt7 interface address</descr>
			</rule>
			<rule>
				<interface>wan</interface>
				<ipprotocol>inet</ipprotocol>
				<source>
					<any></any>
				</source>
				<destination>
					<any></any>
				</destination>
				<target>openvpnip</target>
				<descr>openvpn address</descr>
			</rule>
			<rule>
				<interface>wan</interface>
				<ipprotocol>inet</ipprotocol>
				<source>
					<any></any>
				</source>
				<destination>
					<any></any>
				</destination>
				<target>other-subnet</target>
				<targetip>192.0.2.5</targetip>
				<targetip_subnet>24</targetip_subnet>
				<descr>other subnet</descr>
			</rule>
			<rule>
				<interface>wan</interface>
				<ipprotocol>inet</ipprotocol>
				<source>
					<network>lan</network>
				</source>
				<destination>
					<any></any>
				</destination>
				<poolopts>round-robin</poolopts>
				<descr>pool option rule</descr>
			</rule>
		</outbound>
		<onetoone>
			<interface>wan</interface>
			<type>binat</type>
			<source>
				<address>192.168.1.10</address>
			</source>
			<destination>
				<any></any>
			</destination>
			<external>203.0.113.10</external>
			<descr>one to one host</descr>
		</onetoone>
		<onetoone>
			<interface>wan</interface>
			<source>
				<network>10.0.5.0/24</network>
			</source>
			<destination>
				<any></any>
			</destination>
			<external>203.0.113.0</external>
			<natreflection>disable</natreflection>
			<descr>one to one subnet</descr>
		</onetoone>
	</nat>
</pfsense>
