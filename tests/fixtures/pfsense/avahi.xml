<?xml version="1.0"?>
<pfsense>
	<version>24.0</version>
	<system>
		<hostname>avahibox</hostname>
		<domain>example.test</domain>
	</system>
	<interfaces>
		<opt1>
			<if>em0</if>
			<descr>OPT1</descr>
			<enable></enable>
			<ipaddr>10.0.1.1</ipaddr>
			<subnet>24</subnet>
		</opt1>
		<opt2>
			<if>em1</if>
			<descr>OPT2</descr>
			<enable></enable>
			<ipaddr>10.0.2.1</ipaddr>
			<subnet>24</subnet>
		</opt2>
		<opt3>
			<if>em2</if>
			<descr>OPT3</descr>
			<enable></enable>
			<ipaddr>10.0.3.1</ipaddr>
			<subnet>24</subnet>
		</opt3>
		<opt5>
			<if>em3</if>
			<descr>OPT5</descr>
			<enable></enable>
			<ipaddr>10.0.5.1</ipaddr>
			<subnet>24</subnet>
		</opt5>
	</interfaces>
	<installedpackages>
		<avahi>
			<config>
				<enable>yes</enable>
				<carpstatusvid>none</carpstatusvid>
				<action>allow</action>
				<interfaces>opt1,opt2,opt3,opt5</interfaces>
				<disable_ipv4/>
				<disable_ipv6/>
				<reflection>yes</reflection>
				<override_hostname/>
				<override_domain/>
				<publishing/>
				<filtering/>
			</config>
		</avahi>
	</installedpackages>
</pfsense>
