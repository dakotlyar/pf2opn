<?xml version="1.0"?>
<pfsense>
	<version>24.0</version>
	<system>
		<hostname>vlanbox</hostname>
		<domain>example.test</domain>
	</system>
	<interfaces>
		<wan>
			<if>em0</if>
			<descr>WAN</descr>
			<enable></enable>
			<ipaddr>dhcp</ipaddr>
		</wan>
		<lan>
			<if>em1</if>
			<descr>LAN</descr>
			<enable></enable>
			<ipaddr>192.168.1.1</ipaddr>
			<subnet>24</subnet>
		</lan>
		<opt1>
			<if>em1.10</if>
			<descr>Home &amp;amp; Lab</descr>
			<enable></enable>
			<ipaddr>10.0.10.1</ipaddr>
			<subnet>24</subnet>
		</opt1>
		<opt2>
			<if>em1.20</if>
			<descr>Guests</descr>
			<enable></enable>
			<ipaddr>10.0.20.1</ipaddr>
			<subnet>24</subnet>
		</opt2>
		<opt3>
			<if>ovpns1</if>
			<descr>OpenVPN server</descr>
			<enable></enable>
		</opt3>
	</interfaces>
	<vlans>
		<vlan>
			<if>em1</if>
			<tag>10</tag>
			<descr>Home &amp;amp; Lab</descr>
			<vlanif>em1.10</vlanif>
		</vlan>
		<vlan>
			<if>em1</if>
			<tag>20</tag>
			<descr>Guests</descr>
			<vlanif>em1.20</vlanif>
		</vlan>
		<vlan>
			<if>em1</if>
			<tag>30</tag>
			<descr>Unassigned</descr>
			<vlanif>em1.30</vlanif>
		</vlan>
	</vlans>
</pfsense>
