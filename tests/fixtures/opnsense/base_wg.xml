<?xml version="1.0"?>
<opnsense>
	<system>
		<hostname>WGBase</hostname>
		<domain>example.test</domain>
		<user>
			<name>root</name>
			<scope>system</scope>
			<uid>0</uid>
		</user>
		<group>
			<name>admins</name>
			<scope>system</scope>
			<gid>1999</gid>
			<member>0</member>
		</group>
		<nextuid>2000</nextuid>
		<nextgid>2000</nextgid>
	</system>
	<interfaces>
		<wan>
			<if>igc0</if>
			<descr>WAN</descr>
			<enable></enable>
			<ipaddr>dhcp</ipaddr>
		</wan>
		<lan>
			<if>igc1</if>
			<descr>LAN</descr>
			<enable></enable>
			<ipaddr>192.168.1.1</ipaddr>
			<subnet>24</subnet>
		</lan>
	</interfaces>
	<OPNsense>
		<wireguard>
			<server version="1.0.1">
				<servers>
					<server uuid="aaaaaaaa-0000-4000-8000-000000000001">
						<name>Legacy Tunnels</name>
						<instance>1</instance>
						<enabled>1</enabled>
						<pubkey>synthetic-legacy-key-1</pubkey>
					</server>
					<server uuid="aaaaaaaa-0000-4000-8000-000000000004">
						<name>Leftover</name>
						<instance>4</instance>
						<enabled>1</enabled>
						<pubkey>synthetic-legacy-key-4</pubkey>
					</server>
				</servers>
			</server>
			<client version="1.0.0">
				<clients>
					<client uuid="bbbbbbbb-0000-4000-8000-000000000001">
						<name>GL.iNet_Slate_Router</name>
						<enabled>1</enabled>
						<pubkey>synthetic-stale-key</pubkey>
					</client>
					<client uuid="bbbbbbbb-0000-4000-8000-000000000002">
						<name>Leftover_Client</name>
						<enabled>1</enabled>
						<pubkey>synthetic-leftover-key</pubkey>
					</client>
				</clients>
			</client>
		</wireguard>
	</OPNsense>
</opnsense>
